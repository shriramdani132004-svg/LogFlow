# LogFlow Database Configuration
# Copy this file to .env and fill in your PostgreSQL credentials.

# PostgreSQL host (default: localhost)
DB_HOST=localhost

# PostgreSQL port (default: 5432)
DB_PORT=5432

# Database name (default: logflow)
DB_NAME=logflow

# PostgreSQL user (default: postgres)
DB_USER=postgres

# PostgreSQL password (required - no default)
DB_PASSWORD=

# Batch size for inserts (default: 500)
DB_BATCH_SIZE=500
